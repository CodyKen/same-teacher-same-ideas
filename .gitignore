# Run outputs: keep the small result summaries, prompt splits and annotation sheets;
# ignore raw generations, training data, logs, caches and the blind-review keys.
runs/**
!runs/**/
!runs/locks/*.json
!runs/results/**
!runs/models_meta/**
!runs/prompts/**
!runs/train_data/manifest*.json
# Annotation sheets are shared with the team through the repository. The keys and the
# LLM judge's labels stay local so that annotators stay blind.
!runs/human_eval/**
runs/human_eval/**/key_DO_NOT_OPEN.json
runs/human_eval/**/llm_judge_*
runs/human_eval/**/.DS_Store
